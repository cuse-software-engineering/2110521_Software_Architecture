NODE_ENV=development
PORT=5000

# Option A — MongoDB Atlas (recommended for the recorded demo; open the same cluster in Compass/Atlas Data Explorer)
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ctrs-demo?retryWrites=true&w=majority

# Option B — local MongoDB (docker compose up -d)
DATABASE_URL=mongodb://localhost:27017/ctrs-demo

# Option C — in-memory MongoDB, no install needed (data lost on restart):
#   npm run start:memory
# The server prints a connection string you can paste into Compass while it runs.
MEMORY_DB_PORT=27018
