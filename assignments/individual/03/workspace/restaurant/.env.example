# Copy to .env and fill in your connection string.
# MongoDB Atlas:
#   DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/restaurant?retryWrites=true&w=majority
# Local MongoDB in Docker (npm run mongo):
DATABASE_URL=mongodb://127.0.0.1:27017/restaurant

# gRPC server bind address
GRPC_ADDRESS=127.0.0.1:30043

