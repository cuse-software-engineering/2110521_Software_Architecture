@startuml use-case-diagram
' SEATS use case diagram, project document v2.0 (CH-04, KI-01, KI-02; name CH-22).
' Render: java -jar <plantuml.jar> -tpng assets/use-case-diagram.puml
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 15
skinparam dpi 150
skinparam actor {
  BorderColor #3E4C59
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #D6E9FB
  BorderColor #2B6CB0
  FontSize 15
}
skinparam rectangle {
  BorderColor #3E4C59
  FontSize 17
  FontStyle bold
}
skinparam ArrowColor #3E4C59

actor Customer
actor "Front Staff" as Staff
actor Manager

rectangle "SEATS" {
  usecase "UC-01\nReserve a Specific Table" as UC01
  usecase "UC-02\nCheck In Using\nDigital QR Ticket" as UC02
  usecase "UC-03\nCreate Concert Event" as UC03
  usecase "UC-04\nCreate Venue Zone Map" as UC04
}

actor "Payment Gateway" as PG <<system>>
actor "LINE Platform\n(LINE Login,\nMessaging API)" as LINE <<system>>
actor Time <<timer>>

Customer -- UC01
Customer -- UC02
Staff -- UC02
Manager -- UC01
Manager -- UC02
Manager -- UC03
Manager -- UC04

UC01 -- PG
UC01 -- LINE
UC01 -- Time
UC02 -- Time
@enduml
